// 自动生成：先建约束，再逐条 MERGE 节点与关系
CREATE CONSTRAINT ent_name IF NOT EXISTS FOR (n:Entity) REQUIRE n.name IS UNIQUE;

MERGE (n:Entity {name: "徒弟"}) SET n.type = "POS", n.type_cn = "身份/职务", n.description = "孙少平在煤矿所带的徒弟";
